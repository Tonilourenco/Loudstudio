# Loudstudio — server settings for Hostinger (LiteSpeed, Apache compatible).

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

AddType font/woff2 .woff2
AddType image/webp .webp
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www.loudstudio.com -> loudstudio.com
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Always HTTPS (also behind the Hostinger CDN, which forwards the protocol)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Addresses of the old WordPress site
  RewriteRule ^pro-audio/?$ https://%{HTTP_HOST}/li-lac/ [R=301,L]
  RewriteRule ^(contact|contacts|contacto|contato)/?$ https://%{HTTP_HOST}/contactos/ [R=301,L]
  RewriteRule ^(lilac|li\.lac)/?$ https://%{HTTP_HOST}/li-lac/ [R=301,L]
  RewriteRule ^(studio|estudios)/?$ https://%{HTTP_HOST}/estudio/ [R=301,L]
  RewriteRule ^wp-content/uploads/2021/10/LiLAC_PT2_v2_20211001\.pdf$ https://%{HTTP_HOST}/assets/docs/lilac-ficha-tecnica.pdf [R=301,L]
  RewriteRule ^(feed|comments/feed)/?$ https://%{HTTP_HOST}/ [R=301,L]

  # Answer WordPress probes with a plain 404 (there is no WordPress here)
  RewriteRule ^(wp-admin|wp-includes|wp-content|wp-json)(/|$) - [R=404,L]
  RewriteRule ^(wp-login|xmlrpc|wp-cron|wp-config|wp-signup|wp-trackback)\.php$ - [R=404,L]

  # Backups, dumps, archives and logs must never be downloadable
  RewriteRule ^(cpanel-backups|cgi-bin)(/|$) - [R=404,L]
  RewriteRule \.(sql|gz|tgz|tar|zip|bak|log|ini)$ - [R=404,L]
  RewriteRule (^|/)error_log$ - [R=404,L]

  # Hidden files (except .well-known, used for SSL certificates)
  RewriteRule (^|/)\.(?!well-known/) - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  # The script hash is for the one-line inline script in website/src/layout.html.
  # If that line changes, update the hash (see website/README.md).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-qOhFsq0QMV2REqNwk5hGH5bZE9SkX6gt6yeyKdYPv+U='; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://maps.google.com https://www.google.com; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests"

  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # CSS and JS URLs carry ?v=<hash>, fonts never change: cache for a year
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.pdf$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript application/json application/manifest+json image/svg+xml
</IfModule>
